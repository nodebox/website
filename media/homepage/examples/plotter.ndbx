<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<ndbx formatVersion="21" type="file" uuid="d1d3eb15-3dd7-56e8-b383-5f7aee4beb03">
    <property name="canvasHeight" value="700"/>
    <property name="canvasWidth" value="800"/>
    <property name="title" value="Superformula"/>
    <node name="root" prototype="core.network" renderedChild="copies">
        <node name="th" position="1.00,1.00" prototype="math.sample">
            <port name="amount" type="int" value="240"/>
            <port name="start" type="float" value="0.0"/>
            <port name="end" type="float" value="360.0"/>
        </node>
        <node name="thr" position="1.00,3.00" prototype="math.radians"/>
        <node name="m_steps" position="5.00,3.00" prototype="math.divide">
            <port name="value2" type="float" value="20.0"/>
        </node>
        <node name="m" position="5.00,5.00" prototype="math.add">
            <port name="value2" type="float" value="3.0"/>
        </node>
        <node name="mp" position="3.00,7.00" prototype="math.multiply"/>
        <node name="q" position="3.00,9.00" prototype="math.multiply">
            <port name="value2" type="float" value="0.25"/>
        </node>
        <node name="cq" position="3.00,11.00" prototype="math.cos"/>
        <node name="sq" position="7.00,11.00" prototype="math.sin"/>
        <node name="ac" position="3.00,13.00" prototype="math.abs"/>
        <node name="as" position="11.00,13.00" prototype="math.abs"/>
        <node name="pc" position="5.00,15.00" prototype="math.pow"/>
        <node name="ps" position="9.00,15.00" prototype="math.pow"/>
        <node name="n23" position="7.00,13.00" prototype="math.number">
            <port name="value" type="float" value="1.2"/>
        </node>
        <node name="sum" position="7.00,17.00" prototype="math.add"/>
        <node name="ex" position="11.00,17.00" prototype="math.number">
            <port name="value" type="float" value="-2.2"/>
        </node>
        <node name="rr" position="9.00,19.00" prototype="math.pow"/>
        <node name="rs" position="9.00,21.00" prototype="math.multiply">
            <port name="value2" type="float" value="330.0"/>
        </node>
        <node name="pt" position="5.00,23.00" prototype="math.coordinates"/>
        <node name="ring" position="5.00,25.00" prototype="corevector.connect">
            <port name="closed" type="boolean" value="true"/>
        </node>
        <node name="copies" position="5.00,29.00" prototype="corevector.copy">
            <port name="copies" type="int" value="60"/>
            <port name="rotate" type="float" value="1.5"/>
            <port name="scale" type="point" value="99.00,99.00"/>
        </node>
        <node name="pen" position="5.00,27.00" prototype="corevector.colorize">
            <port name="fill" type="color" value="#00000000"/>
            <port name="stroke" type="color" value="#10253bff"/>
            <port name="strokeWidth" type="float" value="0.6"/>
        </node>
        <node name="frame" position="5.00,1.00" prototype="core.frame"/>
        <conn input="thr.degrees" output="th"/>
        <conn input="mp.value1" output="thr"/>
        <conn input="mp.value2" output="m"/>
        <conn input="q.value1" output="mp"/>
        <conn input="cq.value" output="q"/>
        <conn input="sq.value" output="q"/>
        <conn input="ac.value" output="cq"/>
        <conn input="as.value" output="sq"/>
        <conn input="pc.value1" output="ac"/>
        <conn input="pc.value2" output="n23"/>
        <conn input="ps.value1" output="as"/>
        <conn input="ps.value2" output="n23"/>
        <conn input="sum.value1" output="pc"/>
        <conn input="sum.value2" output="ps"/>
        <conn input="rr.value1" output="sum"/>
        <conn input="rr.value2" output="ex"/>
        <conn input="rs.value1" output="rr"/>
        <conn input="pt.angle" output="th"/>
        <conn input="pt.distance" output="rs"/>
        <conn input="ring.points" output="pt"/>
        <conn input="pen.shape" output="ring"/>
        <conn input="copies.shape" output="pen"/>
        <conn input="m_steps.value1" output="frame"/>
        <conn input="m.value1" output="m_steps"/>
    </node>
</ndbx>
