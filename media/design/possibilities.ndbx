<?xml version="1.0" encoding="UTF-8"?>
<ndbx formatVersion="21" type="file" uuid="nodebox-woven-surface">
  <property name="canvasWidth" value="800" />
  <property name="canvasHeight" value="700" />
  <property name="title" value="Woven surface" />
  <property name="description" value="Two families of paths sampled from a sine surface. Change bend to reshape the mesh. Each subnetwork calculates the same surface in the other direction." />
  <node name="root" prototype="core.network" renderedChild="rotate">
    <node name="rows" prototype="math.range" position="1,1">
      <port name="start" type="float" value="-0.5" />
      <port name="end" type="float" value="0.5001" />
      <port name="step" type="float" value="0.038461538461538464" />
    </node>
    <node name="bend" prototype="math.number" position="5,1">
      <port name="value" type="float" value="150" />
    </node>
    <node name="warp" prototype="core.network" position="3,3" renderedChild="colorize">
      <port name="row" type="float" range="value" value="0" childReference="fixed.value" />
      <port name="bend" type="float" range="value" value="150" childReference="amplitude.value" />
      <node name="samples" prototype="math.range" position="1,1">
        <port name="start" type="float" value="-0.5" />
        <port name="end" type="float" value="0.5001" />
        <port name="step" type="float" value="0.015625" />
      </node>
      <node name="fixed" prototype="math.number" position="5,1">
        <port name="value" type="float" value="0" />
      </node>
      <node name="amplitude" prototype="math.number" position="9,1">
        <port name="value" type="float" value="150" />
      </node>
      <node name="phase_u" prototype="math.multiply" position="1,2">
        <port name="value2" type="float" value="5.6" />
      </node>
      <conn input="phase_u.value1" output="samples" />
      <node name="phase_v" prototype="math.multiply" position="5,2">
        <port name="value2" type="float" value="2.5" />
      </node>
      <conn input="phase_v.value1" output="fixed" />
      <node name="phase" prototype="math.add" position="3,3" />
      <conn input="phase.value1" output="phase_u" />
      <conn input="phase.value2" output="phase_v" />
      <node name="sine" prototype="math.sin" position="3,4" />
      <conn input="sine.value" output="phase" />
      <node name="envelope_phase" prototype="math.multiply" position="9,2">
        <port name="value2" type="float" value="2.4" />
      </node>
      <conn input="envelope_phase.value1" output="fixed" />
      <node name="envelope" prototype="math.cos" position="9,3" />
      <conn input="envelope.value" output="envelope_phase" />
      <node name="wave" prototype="math.multiply" position="6,5" />
      <conn input="wave.value1" output="sine" />
      <conn input="wave.value2" output="envelope" />
      <node name="height" prototype="math.multiply" position="6,6" />
      <conn input="height.value1" output="wave" />
      <conn input="height.value2" output="amplitude" />
      <node name="x_u" prototype="math.multiply" position="1,6">
        <port name="value2" type="float" value="570" />
      </node>
      <conn input="x_u.value1" output="samples" />
      <node name="x_v" prototype="math.multiply" position="3,6">
        <port name="value2" type="float" value="180" />
      </node>
      <conn input="x_v.value1" output="fixed" />
      <node name="x_height" prototype="math.multiply" position="5,7">
        <port name="value2" type="float" value="0.25" />
      </node>
      <conn input="x_height.value1" output="height" />
      <node name="x_plane" prototype="math.add" position="2,7" />
      <conn input="x_plane.value1" output="x_u" />
      <conn input="x_plane.value2" output="x_v" />
      <node name="x" prototype="math.add" position="3,8" />
      <conn input="x.value1" output="x_plane" />
      <conn input="x.value2" output="x_height" />
      <node name="y_v" prototype="math.multiply" position="9,6">
        <port name="value2" type="float" value="410" />
      </node>
      <conn input="y_v.value1" output="fixed" />
      <node name="y_u" prototype="math.multiply" position="11,6">
        <port name="value2" type="float" value="-70" />
      </node>
      <conn input="y_u.value1" output="samples" />
      <node name="y_plane" prototype="math.add" position="10,7" />
      <conn input="y_plane.value1" output="y_v" />
      <conn input="y_plane.value2" output="y_u" />
      <node name="y" prototype="math.add" position="9,8" />
      <conn input="y.value1" output="y_plane" />
      <conn input="y.value2" output="height" />
      <node name="points" prototype="corevector.make_point" position="6,9" />
      <conn input="points.x" output="x" />
      <conn input="points.y" output="y" />
      <node name="connect" prototype="corevector.connect" position="6,10">
        <port name="closed" type="boolean" value="false" />
      </node>
      <conn input="connect.points" output="points" />
      <node name="colorize" prototype="corevector.colorize" position="6,11">
        <port name="fill" type="color" value="#00000000" />
        <port name="stroke" type="color" value="#2355edff" />
        <port name="strokeWidth" type="float" value="1.8" />
      </node>
      <conn input="colorize.shape" output="connect" />
    </node>
    <conn input="warp.row" output="rows" />
    <conn input="warp.bend" output="bend" />
    <node name="weft" prototype="core.network" position="8,3" renderedChild="colorize">
      <port name="row" type="float" range="value" value="0" childReference="fixed.value" />
      <port name="bend" type="float" range="value" value="150" childReference="amplitude.value" />
      <node name="samples" prototype="math.range" position="1,1">
        <port name="start" type="float" value="-0.5" />
        <port name="end" type="float" value="0.5001" />
        <port name="step" type="float" value="0.015625" />
      </node>
      <node name="fixed" prototype="math.number" position="5,1">
        <port name="value" type="float" value="0" />
      </node>
      <node name="amplitude" prototype="math.number" position="9,1">
        <port name="value" type="float" value="150" />
      </node>
      <node name="phase_u" prototype="math.multiply" position="1,2">
        <port name="value2" type="float" value="5.6" />
      </node>
      <conn input="phase_u.value1" output="fixed" />
      <node name="phase_v" prototype="math.multiply" position="5,2">
        <port name="value2" type="float" value="2.5" />
      </node>
      <conn input="phase_v.value1" output="samples" />
      <node name="phase" prototype="math.add" position="3,3" />
      <conn input="phase.value1" output="phase_u" />
      <conn input="phase.value2" output="phase_v" />
      <node name="sine" prototype="math.sin" position="3,4" />
      <conn input="sine.value" output="phase" />
      <node name="envelope_phase" prototype="math.multiply" position="9,2">
        <port name="value2" type="float" value="2.4" />
      </node>
      <conn input="envelope_phase.value1" output="samples" />
      <node name="envelope" prototype="math.cos" position="9,3" />
      <conn input="envelope.value" output="envelope_phase" />
      <node name="wave" prototype="math.multiply" position="6,5" />
      <conn input="wave.value1" output="sine" />
      <conn input="wave.value2" output="envelope" />
      <node name="height" prototype="math.multiply" position="6,6" />
      <conn input="height.value1" output="wave" />
      <conn input="height.value2" output="amplitude" />
      <node name="x_u" prototype="math.multiply" position="1,6">
        <port name="value2" type="float" value="570" />
      </node>
      <conn input="x_u.value1" output="fixed" />
      <node name="x_v" prototype="math.multiply" position="3,6">
        <port name="value2" type="float" value="180" />
      </node>
      <conn input="x_v.value1" output="samples" />
      <node name="x_height" prototype="math.multiply" position="5,7">
        <port name="value2" type="float" value="0.25" />
      </node>
      <conn input="x_height.value1" output="height" />
      <node name="x_plane" prototype="math.add" position="2,7" />
      <conn input="x_plane.value1" output="x_u" />
      <conn input="x_plane.value2" output="x_v" />
      <node name="x" prototype="math.add" position="3,8" />
      <conn input="x.value1" output="x_plane" />
      <conn input="x.value2" output="x_height" />
      <node name="y_v" prototype="math.multiply" position="9,6">
        <port name="value2" type="float" value="410" />
      </node>
      <conn input="y_v.value1" output="samples" />
      <node name="y_u" prototype="math.multiply" position="11,6">
        <port name="value2" type="float" value="-70" />
      </node>
      <conn input="y_u.value1" output="fixed" />
      <node name="y_plane" prototype="math.add" position="10,7" />
      <conn input="y_plane.value1" output="y_v" />
      <conn input="y_plane.value2" output="y_u" />
      <node name="y" prototype="math.add" position="9,8" />
      <conn input="y.value1" output="y_plane" />
      <conn input="y.value2" output="height" />
      <node name="points" prototype="corevector.make_point" position="6,9" />
      <conn input="points.x" output="x" />
      <conn input="points.y" output="y" />
      <node name="connect" prototype="corevector.connect" position="6,10">
        <port name="closed" type="boolean" value="false" />
      </node>
      <conn input="connect.points" output="points" />
      <node name="colorize" prototype="corevector.colorize" position="6,11">
        <port name="fill" type="color" value="#00000000" />
        <port name="stroke" type="color" value="#10253b99" />
        <port name="strokeWidth" type="float" value="0.9" />
      </node>
      <conn input="colorize.shape" output="connect" />
    </node>
    <conn input="weft.row" output="rows" />
    <conn input="weft.bend" output="bend" />
    <node name="combine" prototype="list.combine" position="5,5" />
    <conn input="combine.list1" output="warp" />
    <conn input="combine.list2" output="weft" />
    <node name="rotate" prototype="corevector.rotate" position="5,7">
      <port name="angle" type="float" value="-8" />
    </node>
    <conn input="rotate.shape" output="combine" />
  </node>
</ndbx>
